{
  "name": "kirby-swiper-block",
  "version": "1.0.1",
  "description": "Kirby CMS layout block plugin — Swiper 12 slider with panel editor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:panel\" \"npm run dev:frontend\"",
    "dev:panel": "vite build --watch --config vite.panel.config.js",
    "dev:frontend": "vite build --watch --config vite.frontend.config.js",
    "build": "npm run build:panel && npm run build:frontend",
    "build:panel": "vite build --config vite.panel.config.js",
    "build:frontend": "vite build --config vite.frontend.config.js"
  },
  "dependencies": {
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^9.1.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

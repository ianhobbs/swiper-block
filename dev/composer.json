{
  "name": "ianhobbs/kirby-swiper-block-dev",
  "description": "Development environment for the kirby-swiper-block plugin — Kirby install + Pest suite. Not published.",
  "license": "MIT",
  "type": "project",
  "require-dev": {
    "getkirby/cms": "^5.0",
    "pestphp/pest": "^3.0",
    "bnomei/kirby-mcp": "^1.11"
  },
  "scripts": {
    "test": "pest --colors=always",
    "test:coverage": "pest --colors=always --coverage",
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the Pest suite against the plugin in the parent directory",
    "start" : "Runs kirby's built in server"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": false
    }
  }
}

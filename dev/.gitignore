# Composer output
/vendor/
/kirby/
composer.lock
.phpunit.cache/
/coverage/

# Kirby MCP — both are generated by `vendor/bin/kirby-mcp install --project=dev`
# and follow the installed package version, so they're regenerated, not tracked.
/.kirby-mcp/
/site/commands/mcp/

# Private to your machine — never commit these.
# content/ and media/ hold real test images; accounts/ holds hashed Panel
# credentials; sessions/ and cache/ are runtime state.
/content/
/media/
/site/accounts/
/site/sessions/
/site/cache/

# The visual site's scaffold (index.php, site/blueprints, site/templates,
# site/config and the plugin symlink) IS tracked, so a fresh clone only needs:
#   cd dev && composer install && composer start

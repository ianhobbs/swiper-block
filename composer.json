{
  "name": "ianhobbs/kirby-swiper-block",
  "description": "Kirby CMS layout block plugin — Swiper 12 slider with panel editor and image cropping",
  "type": "kirby-plugin",
  "license": "MIT",
  "authors": [
    { "name": "Ian Hobbs", "email": "admin@ianhobbsmedia.com" }
  ],
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin"
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "bnomei/kirby-mcp": "^1.8"
  },
  "extra": {
    "installer-name": "kirby-swiper-block"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "php-http/discovery": false
    }
  }
}

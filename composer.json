{
  "name": "ianhobbs/kirby-swiper-block",
  "description": "Kirby CMS layout block plugin — Swiper 12 slider with panel editor and image cropping",
  "type": "kirby-plugin",
  "license": "MIT",
  "authors": [
    { "name": "Ian Hobbs", "email": "admin@ianhobbsmedia.com" }
  ],
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "layout-block",
    "swiper",
    "kirby5"
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "getkirby/cms": "^5.1",
    "pestphp/pest": "^3.0"
  },
  "extra": {
    "installer-name": "kirby-swiper-block"
  },
  "scripts": {
    "test": "pest --colors=always",
    "test:coverage": "pest --colors=always --coverage",
    "test:watch": "pest --colors=always --watch"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "php-http/discovery": false,
      "pestphp/pest-plugin": true
    }
  }
}

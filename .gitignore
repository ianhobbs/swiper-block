# OS junk
.DS_Store
Thumbs.db

# Node
node_modules/
# Root-level only: assets/dist holds the COMMITTED frontend bundle (Swiper +
# the block's own code). A bare `dist/` pattern swallowed it, which would ship
# a Composer install with no frontend assets at all.
/dist/
build/
.vite/
.parcel-cache/
public/build/

# Composer / PHP
/vendor/
/kirby/
/kirby
composer.phar

# dev/ holds the whole development environment (Kirby install + Pest suite).
# Its tracked files are composer.json, phpunit.xml and tests/ — everything
# generated is ignored by dev/.gitignore, not from here.
*.log
# Libraries typically don't commit composer.lock
composer.lock

# Kirby MCP (local dev tool, not part of the plugin)
/.kirby-mcp/
/.cache/

# Environment
.env
.env.*

# Coverage / tests
/coverage/
phpunit.xml.cache
.phpunit.cache/

# IDE / editor
/.idea/
/.vscode/
*~
CLAUDE.md
.claude/settings.local.json
.claude
.mcp.json
dev/repository-open-graph-template.png
dev/swiper-block-media.png
dev/swiper-block-media.jpg